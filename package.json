{
  "name": "micro-minds",
  "version": "0.0.0",
  "private": true,
  "description": "A local app that runs AI coding CLI sessions in embedded terminals and visualizes every agent and subagent as a character.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24.2.0"
  },
  "scripts": {
    "postinstall": "node scripts/fix-node-pty.ts",
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "lint": "biome check --error-on-warnings .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit -p . && npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "npm run lint && npm run typecheck && npm test",
    "lint:commits": "node scripts/lint-commits.ts --range origin/main..HEAD",
    "lint:title": "node scripts/lint-commits.ts --title-text",
    "tests:locked": "node scripts/tests-locked.ts",
    "eval:harness": "node evals/harness/reviewer/run.ts",
    "spike:sink": "node spikes/phase-1/sink.ts",
    "spike:settings": "node spikes/phase-1/settings.ts",
    "spike:drive": "node spikes/phase-1/drive.ts",
    "spike:target": "node spikes/phase-1/make-target.ts",
    "spike:relay-selftest": "node spikes/phase-1/relay-selftest.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "24.19.0",
    "@vitest/coverage-v8": "5.0.2",
    "node-pty": "1.1.0",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  }
}
