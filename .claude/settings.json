{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm test *)",
      "Bash(npx biome *)",
      "Bash(npx vitest *)",
      "Bash(npx tsc *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(git branch --list *)",
      "Bash(git branch --show-current)",
      "Bash(git worktree list *)",
      "PowerShell(npm run *)",
      "PowerShell(npm test *)",
      "PowerShell(npx biome *)",
      "PowerShell(npx vitest *)",
      "PowerShell(npx tsc *)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git show *)",
      "PowerShell(git branch)",
      "PowerShell(git branch --list *)",
      "PowerShell(git branch --show-current)",
      "PowerShell(git worktree list *)"
    ],
    "deny": [
      "Read(~/.claude)",
      "Read(~/.claude/**)",
      "Read(!~/.claude/plans/**)",
      "Read(!~/.claude/projects/*/memory/**)",
      "Read(!~/.claude/projects/*/tool-results/**)",
      "Edit(~/.claude/**)",
      "Edit(!~/.claude/plans/**)",
      "Edit(!~/.claude/projects/*/memory/**)",
      "Read(~/.gemini)",
      "Read(~/.gemini/**)",
      "Edit(~/.gemini/**)",
      "Read(~/.codex)",
      "Read(~/.codex/**)",
      "Edit(~/.codex/**)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Read(!.env.sample)",
      "Read(!.env.template)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(!.env.example)",
      "Edit(!.env.sample)",
      "Edit(!.env.template)",
      "Bash(git push *)",
      "Bash(npm publish *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -Rf *)",
      "Bash(rm -r *)",
      "Bash(rm -R *)",
      "PowerShell(git push *)",
      "PowerShell(npm publish *)",
      "PowerShell(Remove-Item *-Recurse*)",
      "PowerShell(Remove-Item *-r *)",
      "PowerShell(Remove-Item *-r)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Read|Edit|Write|MultiEdit|NotebookEdit|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.ts"],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/format.ts"],
            "timeout": 30
          }
        ]
      }
    ]
  }
}
