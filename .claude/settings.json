{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm test *)",
      "Bash(npx biome *)",
      "Bash(npx vitest *)",
      "Bash(npx tsc *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(git branch --list *)",
      "Bash(git branch --show-current)",
      "Bash(git worktree list *)",
      "PowerShell(npm run *)",
      "PowerShell(npm test *)",
      "PowerShell(npx biome *)",
      "PowerShell(npx vitest *)",
      "PowerShell(npx tsc *)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git show *)",
      "PowerShell(git branch)",
      "PowerShell(git branch --list *)",
      "PowerShell(git branch --show-current)",
      "PowerShell(git worktree list *)",
      "Bash(git push -u origin feat/*)",
      "Bash(git push origin feat/*)",
      "Bash(git push -u origin fix/*)",
      "Bash(git push origin fix/*)",
      "Bash(git push -u origin docs/*)",
      "Bash(git push origin docs/*)",
      "Bash(git push -u origin test/*)",
      "Bash(git push origin test/*)",
      "Bash(git push -u origin chore/*)",
      "Bash(git push origin chore/*)",
      "Bash(git push -u origin phase/*)",
      "Bash(git push origin phase/*)",
      "Bash(gh pr create *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr ready *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr list *)",
      "Bash(gh run view *)",
      "PowerShell(git push -u origin feat/*)",
      "PowerShell(git push origin feat/*)",
      "PowerShell(git push -u origin fix/*)",
      "PowerShell(git push origin fix/*)",
      "PowerShell(git push -u origin docs/*)",
      "PowerShell(git push origin docs/*)",
      "PowerShell(git push -u origin test/*)",
      "PowerShell(git push origin test/*)",
      "PowerShell(git push -u origin chore/*)",
      "PowerShell(git push origin chore/*)",
      "PowerShell(git push -u origin phase/*)",
      "PowerShell(git push origin phase/*)",
      "PowerShell(gh pr create *)",
      "PowerShell(gh pr edit *)",
      "PowerShell(gh pr ready *)",
      "PowerShell(gh pr view *)",
      "PowerShell(gh pr checks *)",
      "PowerShell(gh pr list *)",
      "PowerShell(gh run view *)"
    ],
    "deny": [
      "Read(~/.claude)",
      "Read(~/.claude/**)",
      "Read(!~/.claude/plans/**)",
      "Read(!~/.claude/projects/*/memory/**)",
      "Read(!~/.claude/projects/*/tool-results/**)",
      "Edit(~/.claude/**)",
      "Edit(!~/.claude/plans/**)",
      "Edit(!~/.claude/projects/*/memory/**)",
      "Read(~/.gemini)",
      "Read(~/.gemini/**)",
      "Edit(~/.gemini/**)",
      "Read(~/.codex)",
      "Read(~/.codex/**)",
      "Edit(~/.codex/**)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Read(!.env.sample)",
      "Read(!.env.template)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(!.env.example)",
      "Edit(!.env.sample)",
      "Edit(!.env.template)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push * +*)",
      "Bash(git push --delete*)",
      "Bash(git push * --delete*)",
      "Bash(git push * -d *)",
      "Bash(git push origin * *)",
      "Bash(git push -u origin * *)",
      "Bash(git push *:*)",
      "Bash(git push * -d)",
      "Bash(git push * --mirror*)",
      "Bash(git push * --all*)",
      "Bash(git push * --tags*)",
      "Bash(git push * main)",
      "Bash(git push * main:*)",
      "Bash(git push * *:main)",
      "Bash(gh pr merge)",
      "Bash(gh pr merge *)",
      "Bash(npm publish *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -Rf *)",
      "Bash(rm -r *)",
      "Bash(rm -R *)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push * --force*)",
      "PowerShell(git push * -f)",
      "PowerShell(git push * -f *)",
      "PowerShell(git push * +*)",
      "PowerShell(git push --delete*)",
      "PowerShell(git push * --delete*)",
      "PowerShell(git push * -d *)",
      "PowerShell(git push origin * *)",
      "PowerShell(git push -u origin * *)",
      "PowerShell(git push *:*)",
      "PowerShell(git push * -d)",
      "PowerShell(git push * --mirror*)",
      "PowerShell(git push * --all*)",
      "PowerShell(git push * --tags*)",
      "PowerShell(git push * main)",
      "PowerShell(git push * main:*)",
      "PowerShell(git push * *:main)",
      "PowerShell(gh pr merge)",
      "PowerShell(gh pr merge *)",
      "PowerShell(npm publish *)",
      "PowerShell(Remove-Item *-Recurse*)",
      "PowerShell(Remove-Item *-r *)",
      "PowerShell(Remove-Item *-r)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/session-context.ts"],
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Read|Edit|Write|NotebookEdit|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.ts"],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/format.ts"],
            "timeout": 30
          }
        ]
      }
    ]
  }
}
