+import { describe, expect, it } from 'vitest';
+import { toolSummary } from './summary.ts';
+
+describe('toolSummary', () => {
+  it.each([
+    ['Bash', { command: 'npm test' }, 'npm test'],
+    ['Read', { file_path: 'src/index.ts' }, 'src/index.ts'],
+    ['Edit', { file_path: 'src/reduce.ts', old_string: 'a', new_string: 'b' }, 'src/reduce.ts'],
+    ['Write', { file_path: 'notes.txt', content: 'hello' }, 'notes.txt'],
+    ['Agent', { description: 'List files', prompt: 'long prompt' }, 'List files'],
+    ['Task', { description: 'Review', prompt: 'long prompt' }, 'Review'],
+  ])('%s → its summary', (tool, input, expected) => {
+    expect(toolSummary(tool, input)).toBe(expected);
+  });
+
+  it('joins a multi-line command into one line', () => {
+    expect(toolSummary('Bash', { command: 'git add .\n  git commit -m "x"' })).toBe(
+      'git add . git commit -m "x"',
+    );
+  });
+
+  it('cuts a long command to 120 characters with an ellipsis', () => {
+    const summary = toolSummary('Bash', { command: 'x'.repeat(300) });
+    expect(summary).toHaveLength(120);
+    expect(summary?.endsWith('…')).toBe(true);
+  });
+
+  it.each([
+    ['WebFetch', { url: 'https://example.com' }],
+    ['Bash', { command: 42 }],
+    ['Read', null],
+    ['Bash', 'not an object'],
+  ])('%s with %j → no summary', (tool, input) => {
+    expect(toolSummary(tool, input)).toBeUndefined();
+  });
+});
