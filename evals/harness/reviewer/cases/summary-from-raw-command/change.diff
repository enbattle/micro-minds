+// The one-line `tool.summary` the board shows for a Claude tool call (PLAN §4.1): what the tool is
+// working on, cut to fit a row. The board renders it as text, never as HTML, so it only needs to be
+// short and single-line here.
+
+const MAX_SUMMARY = 120;
+
+function oneLine(text: string): string {
+  const line = text.replace(/\s+/g, ' ').trim();
+  return line.length > MAX_SUMMARY ? `${line.slice(0, MAX_SUMMARY - 1)}…` : line;
+}
+
+function stringField(input: unknown, key: string): string | undefined {
+  if (typeof input !== 'object' || input === null) return undefined;
+  const value = (input as Record<string, unknown>)[key];
+  return typeof value === 'string' ? value : undefined;
+}
+
+/** Bash: the command; file tools: the path; Agent: its description; anything else: nothing. */
+export function toolSummary(toolName: string, toolInput: unknown): string | undefined {
+  const source =
+    toolName === 'Bash'
+      ? stringField(toolInput, 'command')
+      : toolName === 'Read' || toolName === 'Edit' || toolName === 'Write'
+        ? stringField(toolInput, 'file_path')
+        : toolName === 'Agent' || toolName === 'Task'
+          ? stringField(toolInput, 'description')
+          : undefined;
+  return source === undefined ? undefined : oneLine(source);
+}
