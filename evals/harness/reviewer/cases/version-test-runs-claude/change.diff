@@ -0,0 +1,5 @@
+/** The CLI version from `claude --version` output (`2.1.283 (Claude Code)`), for preflight. */
+export function parseClaudeVersion(output: string): string | undefined {
+  const match = /^\s*(\d+\.\d+\.\d+)(?:[-+][0-9A-Za-z.-]+)?\b/.exec(output);
+  return match?.[1];
+}
