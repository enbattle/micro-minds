+import { describe, expect, it } from 'vitest';
+import { DEFAULT_FAILURE_THRESHOLDS, healthForFailures, recentFailures } from './severity.ts';
+
+const MIN = 60_000;
+const NOW = 1_800_000_000_000;
+
+describe('healthForFailures', () => {
+  it.each([
+    { name: 'no failures → ok', times: [], expected: 'ok' },
+    { name: 'one failure → notice, not error', times: [NOW - MIN], expected: 'notice' },
+    { name: 'two failures → notice', times: [NOW - 2 * MIN, NOW - MIN], expected: 'notice' },
+    {
+      name: 'four failures in 5 min → warning',
+      times: [NOW - 4 * MIN, NOW - 3 * MIN, NOW - 2 * MIN, NOW - MIN],
+      expected: 'warning',
+    },
+    {
+      name: 'old failures outside the window → ok',
+      times: [NOW - 20 * MIN, NOW - 15 * MIN, NOW - 10 * MIN, NOW - 6 * MIN],
+      expected: 'ok',
+    },
+  ])('$name', ({ times, expected }) => {
+    expect(healthForFailures(times, NOW)).toBe(expected);
+  });
+});
+
+describe('recentFailures', () => {
+  it('keeps failures inside the window, including the edge', () => {
+    const edge = NOW - DEFAULT_FAILURE_THRESHOLDS.windowMs;
+    expect(recentFailures([edge - 1, edge, NOW], NOW, DEFAULT_FAILURE_THRESHOLDS)).toEqual([
+      edge,
+      NOW,
+    ]);
+  });
+});
