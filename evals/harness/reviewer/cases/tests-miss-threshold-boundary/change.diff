+// Health from tool failures (PLAN §6). Pure: `now` comes from the event or the clock.tick that
+// triggered the evaluation (hard rule 9), never from Date.now().
+
+export interface FailureThresholds {
+  /** How far back failures count, in ms (PLAN §6: 5 minutes). */
+  windowMs: number;
+  /** Failures within the window that turn health amber (PLAN §6: 3). */
+  warnFailures: number;
+}
+
+export const DEFAULT_FAILURE_THRESHOLDS: FailureThresholds = {
+  windowMs: 5 * 60_000,
+  warnFailures: 3,
+};
+
+export type FailureHealth = 'ok' | 'notice' | 'warning';
+
+/** Failures that still count at `now`: inside the window, oldest first. */
+export function recentFailures(
+  failureTimes: readonly number[],
+  now: number,
+  cfg: FailureThresholds,
+): number[] {
+  return failureTimes.filter((t) => now - t <= cfg.windowMs);
+}
+
+/**
+ * One failure is a notice, not a problem. Repeated failures inside the window are a warning.
+ * "Repeated" means more failures than the threshold, so a single retry burst doesn't flash amber.
+ */
+export function healthForFailures(
+  failureTimes: readonly number[],
+  now: number,
+  cfg: FailureThresholds = DEFAULT_FAILURE_THRESHOLDS,
+): FailureHealth {
+  const recent = recentFailures(failureTimes, now, cfg);
+  if (recent.length > cfg.warnFailures) return 'warning';
+  if (recent.length > 0) return 'notice';
+  return 'ok';
+}
