+/**
+ * The board's reason for a crash: the adapter puts the exit code in `text` ("exit 3"); a signal
+ * name ("SIGKILL") or nothing at all reads as "crashed".
+ */
+export function describeCrash(text: string | undefined): string {
+  const code = text === undefined ? undefined : /^exit (\d+)$/.exec(text.trim())?.[1];
+  return code === undefined ? 'crashed' : `crashed (exit code ${code})`;
+}
