+// The crash reason on the board: "crashed (exit code 3)" when the adapter reports an exit code.
+import { describe, expect, it } from 'vitest';
+import { describeCrash } from './reduce.ts';
+
+describe('describeCrash', () => {
+  it.each([
+    ['exit 3', 'crashed (exit code 3)'],
+    ['exit 137', 'crashed (exit code 137)'],
+    ['  exit 1 ', 'crashed (exit code 1)'],
+  ])('%j → %j', (text, expected) => {
+    expect(describeCrash(text)).toBe(expected);
+  });
+
+  it.each([[undefined], ['SIGKILL'], ['exit'], ['exit -1'], ['']])(
+    '%j → plain "crashed"',
+    (text) => {
+      expect(describeCrash(text)).toBe('crashed');
+    },
+  );
+});
