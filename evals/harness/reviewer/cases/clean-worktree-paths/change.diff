+import os from 'node:os';
+import path from 'node:path';
+import { describe, expect, it } from 'vitest';
+import { worktreeLocation } from './paths.ts';
+
+const HOME = path.join(os.tmpdir(), 'micro-minds-test-home');
+const SESSION = '01J9ZQ4X7M3V6T8K2R5N0PWYBD';
+
+describe('worktreeLocation', () => {
+  it.each([
+    { name: 'plain repo', repo: path.join(os.tmpdir(), 'projects', 'micro-minds'), slug: 'micro-minds' },
+    { name: 'trailing separator', repo: path.join(os.tmpdir(), 'projects', 'My App') + path.sep, slug: 'my-app' },
+  ])('$name → <home>/worktrees/$slug/<id>', ({ repo, slug }) => {
+    expect(worktreeLocation(HOME, repo, SESSION)).toEqual({
+      dir: path.join(HOME, 'worktrees', slug, SESSION),
+      branch: `micro-minds/${SESSION}`,
+    });
+  });
+
+  it.each(['../../etc', 'abc', `${SESSION}/..`, ''])('rejects session id %j', (id) => {
+    expect(() => worktreeLocation(HOME, os.tmpdir(), id)).toThrow('invalid session id');
+  });
+});
