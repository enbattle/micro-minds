+import path from 'node:path';
+import { slugify } from './slug.ts';
+
+export interface WorktreeLocation {
+  dir: string;
+  branch: string;
+}
+
+const ULID = /^[0-9A-HJKMNP-TV-Z]{26}$/;
+
+/**
+ * Where a session's worktree lives: `<home>/worktrees/<repo-slug>/<sessionId>` (PLAN D12).
+ * `home` is MICROMINDS_HOME from the typed server config. The session id is checked so it can
+ * never escape the worktrees directory.
+ */
+export function worktreeLocation(
+  home: string,
+  repoPath: string,
+  sessionId: string,
+): WorktreeLocation {
+  if (!ULID.test(sessionId)) throw new Error(`invalid session id: ${sessionId}`);
+  const repoSlug = slugify(path.basename(path.resolve(repoPath))) || 'repo';
+  return {
+    dir: path.join(home, 'worktrees', repoSlug, sessionId),
+    // A git ref name, not a filesystem path: always forward slashes.
+    branch: `micro-minds/${sessionId}`,
+  };
+}
