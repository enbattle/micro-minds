+import { describe, expect, it } from 'vitest';
+import { addUsage, type UsageTotals, ZERO_USAGE } from './usage.js';
+
+const delta: UsageTotals = {
+  inputTokens: 12,
+  outputTokens: 582,
+  cacheReadTokens: 156_597,
+  cacheWriteTokens: 16_105,
+  costUsd: 0.25,
+};
+
+describe('addUsage', () => {
+  it('adds every field of a delta to the totals', () => {
+    expect(addUsage(ZERO_USAGE, delta)).toEqual(delta);
+    expect(addUsage(delta, delta)).toEqual({
+      inputTokens: 24,
+      outputTokens: 1164,
+      cacheReadTokens: 313_194,
+      cacheWriteTokens: 32_210,
+      costUsd: 0.5,
+    });
+  });
+
+  it('leaves both arguments unchanged', () => {
+    const total = { ...delta };
+    addUsage(total, delta);
+    expect(total).toEqual(delta);
+    expect(ZERO_USAGE.costUsd).toBe(0);
+  });
+});
