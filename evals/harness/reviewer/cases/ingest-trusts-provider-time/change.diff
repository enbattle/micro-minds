+import { describe, expect, it } from 'vitest';
+import { type NormalizedFacts, stampEvent } from './stamp.ts';
+
+const clock = { now: () => 1_790_000_000_000 };
+
+const facts: NormalizedFacts = {
+  sessionId: '01K6A2B3C4D5E6F7G8H9J0K1M2',
+  provider: 'claude',
+  agentId: '01K6A2B3C4D5E6F7G8H9J0K1M2',
+  kind: 'prompt.submitted',
+};
+
+describe('stampEvent', () => {
+  it('adds the schema version and an id', () => {
+    const event = stampEvent(facts, clock);
+    expect(event.v).toBe(1);
+    expect(typeof event.id).toBe('string');
+    expect(event.id).not.toBe(stampEvent(facts, clock).id);
+  });
+
+  it('uses the server clock when the payload has no time', () => {
+    expect(stampEvent(facts, clock).ts).toBe(1_790_000_000_000);
+    expect(stampEvent({ ...facts, raw: { timestamp: 'not a date' } }, clock).ts).toBe(
+      1_790_000_000_000,
+    );
+    expect(stampEvent({ ...facts, raw: { timestamp: null } }, clock).ts).toBe(1_790_000_000_000);
+  });
+
+  it('keeps the provider time when the payload has one', () => {
+    expect(stampEvent({ ...facts, raw: { timestamp: 1_789_999_999_000 } }, clock).ts).toBe(
+      1_789_999_999_000,
+    );
+    expect(
+      stampEvent({ ...facts, raw: { timestamp: '2026-09-21T10:00:00.000Z' } }, clock).ts,
+    ).toBe(Date.parse('2026-09-21T10:00:00.000Z'));
+  });
+});
