+// Turns an adapter's normalized facts into a stored AgentEvent: the server adds the event id, the
+// schema version and the timestamp. When the provider says when something happened, that time is
+// kept, because receipt time lags behind under load and would reorder a burst of hook events.
+import { randomUUID } from 'node:crypto';
+import { type AgentEvent, EVENT_SCHEMA_VERSION } from '@micro-minds/shared';
+
+export type NormalizedFacts = Omit<AgentEvent, 'v' | 'id' | 'ts'>;
+
+export interface Clock {
+  now(): number;
+}
+
+/** The provider's own time for the event, if its payload carries one (ms epoch or ISO string). */
+function providerTime(raw: unknown): number | undefined {
+  if (typeof raw !== 'object' || raw === null || !('timestamp' in raw)) return undefined;
+  const value = (raw as { timestamp: unknown }).timestamp;
+  if (typeof value === 'number' && Number.isFinite(value)) return value;
+  if (typeof value === 'string') {
+    const parsed = Date.parse(value);
+    return Number.isNaN(parsed) ? undefined : parsed;
+  }
+  return undefined;
+}
+
+export function stampEvent(facts: NormalizedFacts, clock: Clock): AgentEvent {
+  return {
+    ...facts,
+    v: EVENT_SCHEMA_VERSION,
+    id: randomUUID(),
+    ts: providerTime(facts.raw) ?? clock.now(),
+  };
+}
