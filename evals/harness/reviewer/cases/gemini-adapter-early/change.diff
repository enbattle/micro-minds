+import { describe, expect, it } from 'vitest';
+import { geminiToolCategory } from './tools.ts';
+
+describe('geminiToolCategory', () => {
+  it.each([
+    ['read_file', 'read'],
+    ['search_file_content', 'read'],
+    ['write_file', 'write'],
+    ['replace', 'write'],
+    ['run_shell_command', 'exec'],
+    ['google_web_search', 'web'],
+  ] as const)('maps %s to %s', (tool, category) => {
+    expect(geminiToolCategory(tool)).toBe(category);
+  });
+
+  it('maps unknown, MCP and prototype names to other', () => {
+    expect(geminiToolCategory('mcp__github__create_issue')).toBe('other');
+    expect(geminiToolCategory('toString')).toBe('other');
+    expect(geminiToolCategory('')).toBe('other');
+  });
+});
