+// Gemini CLI tool names → the cross-provider ToolCategory (PLAN §4.1). Written now, next to the
+// Claude mapping while it's fresh, so the Phase 5 Gemini adapter only has to wire up its hooks.
+import type { ToolCategory } from '@micro-minds/shared';
+
+const GEMINI_TOOLS: Readonly<Record<string, ToolCategory>> = {
+  read_file: 'read',
+  read_many_files: 'read',
+  list_directory: 'read',
+  glob: 'read',
+  search_file_content: 'read',
+  write_file: 'write',
+  replace: 'write',
+  run_shell_command: 'exec',
+  web_fetch: 'web',
+  google_web_search: 'web',
+};
+
+/** Unknown and MCP tools are `other`: never a throw (hard rule 7). */
+export function geminiToolCategory(toolName: string): ToolCategory {
+  return Object.hasOwn(GEMINI_TOOLS, toolName) ? (GEMINI_TOOLS[toolName] ?? 'other') : 'other';
+}
