+++ b/apps/server/src/ws/authorize-upgrade.ts
@@ -0,0 +1,74 @@
+import { timingSafeEqual } from 'node:crypto';
+import type { IncomingHttpHeaders } from 'node:http';
+import { z } from 'zod';
+
+const SESSION_COOKIE = 'mm_session';
+
+const UpgradeHeaders = z.object({
+  host: z.string().max(256),
+  origin: z.string().max(256).optional(),
+  cookie: z.string().max(4096).optional(),
+  'x-micro-minds-session': z.string().max(64).optional(),
+  'x-micro-minds-hook-token': z.string().max(256).optional(),
+});
+
+export interface Credentials {
+  /** The HttpOnly UI session cookie issued by the bootstrap exchange (ADR 0026). */
+  readonly uiSession: string;
+  /** Hook token of a live session, or undefined if the session doesn't exist. */
+  hookToken(sessionId: string): string | undefined;
+}
+
+export interface AllowList {
+  readonly hosts: ReadonlySet<string>;
+  readonly origins: ReadonlySet<string>;
+}
+
+export type Principal = { kind: 'ui' } | { kind: 'session'; sessionId: string };
+
+function safeEquals(a: string, b: string): boolean {
+  const left = Buffer.from(a, 'utf8');
+  const right = Buffer.from(b, 'utf8');
+  return left.length === right.length && timingSafeEqual(left, right);
+}
+
+function readCookie(header: string | undefined, name: string): string | undefined {
+  for (const part of header?.split(';') ?? []) {
+    const [key, ...rest] = part.trim().split('=');
+    if (key === name) return rest.join('=');
+  }
+  return undefined;
+}
+
+/**
+ * Authorizes a WS upgrade before the handshake completes. The browser UI presents its session
+ * cookie. Tooling running inside a session (it has MICROMINDS_HOOK_TOKEN in its env) may also
+ * attach with its session id and hook token, e.g. to stream its own PTY output.
+ */
+export function authorizeUpgrade(
+  rawHeaders: IncomingHttpHeaders,
+  credentials: Credentials,
+  allow: AllowList,
+): Principal | null {
+  const parsed = UpgradeHeaders.safeParse(rawHeaders);
+  if (!parsed.success || !allow.hosts.has(parsed.data.host)) return null;
+  const headers = parsed.data;
+
+  const cookie = readCookie(headers.cookie, SESSION_COOKIE);
+  if (
+    headers.origin !== undefined &&
+    allow.origins.has(headers.origin) &&
+    cookie !== undefined &&
+    safeEquals(cookie, credentials.uiSession)
+  ) {
+    return { kind: 'ui' };
+  }
+
+  const sessionId = headers['x-micro-minds-session'];
+  const presented = headers['x-micro-minds-hook-token'];
+  if (sessionId === undefined || presented === undefined) return null;
+  const expected = credentials.hookToken(sessionId);
+  return expected !== undefined && safeEquals(presented, expected)
+    ? { kind: 'session', sessionId }
+    : null;
+}
