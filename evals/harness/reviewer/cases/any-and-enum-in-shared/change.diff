+/** Cross-provider tool categories (PLAN §4.1). Adapters map their tool names onto these. */
+export enum ToolCategory {
+  Read = 'read',
+  Write = 'write',
+  Exec = 'exec',
+  Delegate = 'delegate',
+  Ask = 'ask',
+  Web = 'web',
+  Other = 'other',
+}
+
+const ALL_CATEGORIES: readonly string[] = Object.values(ToolCategory);
+
+export function isToolCategory(value: any): value is ToolCategory {
+  return ALL_CATEGORIES.includes(value);
+}
+
+/** Short label for the board's activity column. */
+export function categoryLabel(category: ToolCategory): string {
+  switch (category) {
+    case ToolCategory.Read:
+      return 'reading';
+    case ToolCategory.Write:
+      return 'writing';
+    case ToolCategory.Exec:
+      return 'running';
+    case ToolCategory.Delegate:
+      return 'delegating';
+    case ToolCategory.Ask:
+      return 'asking';
+    case ToolCategory.Web:
+      return 'browsing';
+    case ToolCategory.Other:
+      return 'working';
+  }
+}
