+++ b/apps/web/src/prefs.test.ts
@@ -0,0 +1,58 @@
+import { describe, expect, it } from 'vitest';
+import { createPrefsStore, DEFAULT_PREFS, loadPrefs, savePrefs } from './prefs.ts';
+
+function memoryStorage(initial?: string) {
+  const items = new Map<string, string>();
+  if (initial !== undefined) items.set('micro-minds.prefs', initial);
+  return {
+    items,
+    getItem: (key: string) => items.get(key) ?? null,
+    setItem: (key: string, value: string) => {
+      items.set(key, value);
+    },
+  };
+}
+
+describe('loadPrefs', () => {
+  it('returns the defaults when nothing is stored', () => {
+    expect(loadPrefs(memoryStorage())).toEqual(DEFAULT_PREFS);
+  });
+
+  it('returns stored preferences that match the schema', () => {
+    const stored = { sceneVisible: false, boardSort: 'name', drawerHeight: 500 };
+    expect(loadPrefs(memoryStorage(JSON.stringify(stored)))).toEqual(stored);
+  });
+
+  it('falls back to the defaults on invalid JSON', () => {
+    expect(loadPrefs(memoryStorage('{not json'))).toEqual(DEFAULT_PREFS);
+  });
+
+  it('falls back to the defaults when the schema rejects the stored value', () => {
+    const stored = { sceneVisible: 'yes', boardSort: 'name', drawerHeight: 50 };
+    expect(loadPrefs(memoryStorage(JSON.stringify(stored)))).toEqual(DEFAULT_PREFS);
+  });
+});
+
+describe('savePrefs', () => {
+  it('stores preferences that load back unchanged', () => {
+    const storage = memoryStorage();
+    const prefs = { sceneVisible: false, boardSort: 'recent', drawerHeight: 240 } as const;
+    savePrefs(storage, prefs);
+    expect(loadPrefs(storage)).toEqual(prefs);
+  });
+
+  it('refuses preferences outside the schema', () => {
+    expect(() => savePrefs(memoryStorage(), { ...DEFAULT_PREFS, drawerHeight: 5 })).toThrow();
+  });
+});
+
+describe('createPrefsStore', () => {
+  it('starts from the stored preferences and persists every update', () => {
+    const storage = memoryStorage(JSON.stringify({ ...DEFAULT_PREFS, boardSort: 'name' }));
+    const store = createPrefsStore(storage);
+    expect(store.getState().prefs.boardSort).toBe('name');
+    store.getState().update({ sceneVisible: false });
+    expect(store.getState().prefs.sceneVisible).toBe(false);
+    expect(loadPrefs(storage).sceneVisible).toBe(false);
+  });
+});
