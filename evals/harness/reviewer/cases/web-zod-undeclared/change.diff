@@ -0,0 +1,50 @@
+// UI preferences (board layout, scene visibility), kept in the browser's localStorage. They're
+// read back through a zod schema: anything stored by an older build, or edited by hand, falls back
+// to the defaults instead of breaking the UI.
+//
+// zod is already in the tree through @micro-minds/shared (npm hoists it to the root node_modules),
+// so the web workspace only adds zustand.
+import { z } from 'zod';
+import { create } from 'zustand';
+
+const PREFS_KEY = 'micro-minds.prefs';
+
+const Prefs = z.object({
+  sceneVisible: z.boolean(),
+  boardSort: z.enum(['attention', 'name', 'recent']),
+  drawerHeight: z.number().int().min(120).max(2000),
+});
+export type Prefs = z.infer<typeof Prefs>;
+
+export const DEFAULT_PREFS: Prefs = { sceneVisible: true, boardSort: 'attention', drawerHeight: 320 };
+
+export function loadPrefs(storage: Pick<Storage, 'getItem'>): Prefs {
+  const text = storage.getItem(PREFS_KEY);
+  if (text === null) return DEFAULT_PREFS;
+  try {
+    const parsed = Prefs.safeParse(JSON.parse(text));
+    return parsed.success ? parsed.data : DEFAULT_PREFS;
+  } catch {
+    return DEFAULT_PREFS;
+  }
+}
+
+export function savePrefs(storage: Pick<Storage, 'setItem'>, prefs: Prefs): void {
+  storage.setItem(PREFS_KEY, JSON.stringify(Prefs.parse(prefs)));
+}
+
+interface PrefsStore {
+  prefs: Prefs;
+  update: (patch: Partial<Prefs>) => void;
+}
+
+export function createPrefsStore(storage: Pick<Storage, 'getItem' | 'setItem'>) {
+  return create<PrefsStore>((set, get) => ({
+    prefs: loadPrefs(storage),
+    update: (patch) => {
+      const prefs = { ...get().prefs, ...patch };
+      savePrefs(storage, prefs);
+      set({ prefs });
+    },
+  }));
+}
