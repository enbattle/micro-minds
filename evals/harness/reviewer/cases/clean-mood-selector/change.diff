+import { describe, expect, it } from 'vitest';
+import { type Mood, type MoodInput, mood } from './mood.ts';
+import type { Activity } from './types.ts';
+
+describe('mood', () => {
+  it.each<{ name: string; input: MoodInput; expected: Mood }>([
+    { name: 'error outranks working', input: { activity: 'running', health: 'error' }, expected: 'distressed' },
+    { name: 'error outranks waiting', input: { activity: 'waiting_input', health: 'error' }, expected: 'distressed' },
+    { name: 'warning while working', input: { activity: 'thinking', health: 'warning' }, expected: 'worried' },
+    { name: 'one failure, still working', input: { activity: 'reading', health: 'notice' }, expected: 'frustrated' },
+    { name: 'healthy and working', input: { activity: 'writing', health: 'ok' }, expected: 'focused' },
+    { name: 'waiting for permission', input: { activity: 'waiting_permission', health: 'ok' }, expected: 'waiting' },
+    { name: 'waiting for input', input: { activity: 'waiting_input', health: 'notice' }, expected: 'waiting' },
+    { name: 'idle after a turn', input: { activity: 'idle', health: 'ok' }, expected: 'idle' },
+    { name: 'starting', input: { activity: 'starting', health: 'ok' }, expected: 'starting' },
+    { name: 'subagent done', input: { activity: 'done', health: 'ok' }, expected: 'done' },
+    { name: 'session ended', input: { activity: 'offline', health: 'ok' }, expected: 'offline' },
+  ])('$name → $expected', ({ input, expected }) => {
+    expect(mood(input)).toBe(expected);
+  });
+
+  const working: Activity[] = ['thinking', 'reading', 'writing', 'running', 'delegating'];
+
+  it.each(working)('working (%s) is never the idle mood', (activity) => {
+    expect(mood({ activity, health: 'ok' })).not.toBe(mood({ activity: 'idle', health: 'ok' }));
+  });
+});
