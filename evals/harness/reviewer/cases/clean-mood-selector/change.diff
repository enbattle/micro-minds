+import type { Activity, AgentState } from './types.ts';
+
+export const MOODS = [
+  'distressed',
+  'worried',
+  'frustrated',
+  'focused',
+  'waiting',
+  'idle',
+  'starting',
+  'done',
+  'offline',
+] as const;
+
+export type Mood = (typeof MOODS)[number];
+
+const WORKING_ACTIVITIES = ['thinking', 'reading', 'writing', 'running', 'delegating'] as const;
+
+type WorkingActivity = (typeof WORKING_ACTIVITIES)[number];
+
+function isWorking(activity: Activity): activity is WorkingActivity {
+  return (WORKING_ACTIVITIES as readonly Activity[]).includes(activity);
+}
+
+export type MoodInput = Pick<AgentState, 'activity' | 'health'>;
+
+/**
+ * Pure mood selector (PLAN §4.4, D22). Rows are checked in table order and the first match
+ * wins, so health outranks activity. Attention is drawn as a separate overlay, not a mood.
+ */
+export function mood(agent: MoodInput): Mood {
+  const { activity, health } = agent;
+  if (health === 'error') return 'distressed';
+  if (health === 'warning') return 'worried';
+  if (isWorking(activity)) return health === 'notice' ? 'frustrated' : 'focused';
+  switch (activity) {
+    case 'waiting_permission':
+    case 'waiting_input':
+      return 'waiting';
+    case 'idle':
+      return 'idle';
+    case 'starting':
+      return 'starting';
+    case 'done':
+      return 'done';
+    case 'offline':
+      return 'offline';
+  }
+}
