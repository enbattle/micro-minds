+import type { EventKind } from '@micro-minds/shared';
+
+/**
+ * Claude's `Notification` hook by `notification_type` (docs/protocols/claude.md). `idle_prompt`
+ * raises the idle hand and `elicitation_dialog` a question. `permission_prompt` duplicates the
+ * `PermissionRequest` that already raised the hand, and the other types (auth success, progress
+ * pings) carry nothing the board shows, so they're dropped here instead of cluttering the event
+ * log with `unknown` rows nobody reads.
+ */
+export function notificationKinds(payload: Record<string, unknown>): EventKind[] {
+  switch (payload.notification_type) {
+    case 'idle_prompt':
+      return ['attention.idle'];
+    case 'elicitation_dialog':
+      return ['attention.question'];
+    default:
+      return [];
+  }
+}
