+import { readFileSync } from 'node:fs';
+import path from 'node:path';
+import { describe, expect, it } from 'vitest';
+import { notificationKinds } from './notification.ts';
+
+const FIXTURES = path.resolve(import.meta.dirname, '../../../../../fixtures/claude');
+
+function notifications(file: string): Record<string, unknown>[] {
+  return readFileSync(path.join(FIXTURES, file), 'utf8')
+    .split('\n')
+    .filter((line) => line.trim() !== '')
+    .map((line) => JSON.parse(line) as Record<string, unknown>)
+    .filter((payload) => payload.hook_event_name === 'Notification');
+}
+
+describe('notificationKinds', () => {
+  it('replays the compaction fixture: idle_prompt raises the idle hand', () => {
+    const payloads = notifications('compaction.jsonl');
+    expect(payloads.length).toBeGreaterThan(0);
+    for (const payload of payloads) expect(notificationKinds(payload)).toEqual(['attention.idle']);
+  });
+
+  it('an elicitation dialog is a question', () => {
+    expect(notificationKinds({ notification_type: 'elicitation_dialog' })).toEqual([
+      'attention.question',
+    ]);
+  });
+
+  it.each(['permission_prompt', 'auth_success', undefined, 42])(
+    'anything else yields no event: %j',
+    (type) => {
+      expect(notificationKinds({ notification_type: type })).toEqual([]);
+    },
+  );
+});
