+import { describe, expect, it } from 'vitest';
+import { createScrollback, MAX_SCROLLBACK_BYTES } from './scrollback.ts';
+
+describe('createScrollback', () => {
+  it('replays everything appended while under the limit', () => {
+    const scrollback = createScrollback(64);
+    scrollback.append('hello ');
+    scrollback.append('\u001b[32mworld\u001b[0m');
+    expect(scrollback.snapshot()).toBe('hello \u001b[32mworld\u001b[0m');
+    expect(scrollback.size).toBe(Buffer.byteLength(scrollback.snapshot()));
+  });
+
+  it('keeps only the newest bytes once over the limit', () => {
+    const scrollback = createScrollback(8);
+    scrollback.append('abcdef');
+    scrollback.append('ghijkl');
+    expect(scrollback.snapshot()).toBe('efghijkl');
+    expect(scrollback.size).toBe(8);
+  });
+
+  it('defaults to MAX_SCROLLBACK_BYTES', () => {
+    const scrollback = createScrollback();
+    scrollback.append('x'.repeat(MAX_SCROLLBACK_BYTES + 10));
+    expect(scrollback.size).toBe(MAX_SCROLLBACK_BYTES);
+  });
+
+  it('rejects a limit that is not a positive integer', () => {
+    expect(() => createScrollback(0)).toThrow(RangeError);
+    expect(() => createScrollback(1.5)).toThrow(RangeError);
+  });
+});
