+// Scrollback for reconnecting browser tabs. Rather than a headless xterm per session, keep the
+// last MAX_SCROLLBACK_BYTES of raw PTY output and replay it on `pty.snapshot`: a reconnecting
+// xterm.js re-renders it the same way it did live, and each session costs a few buffers instead
+// of a second terminal emulator (and no @xterm/headless dependency on the server).
+
+export const MAX_SCROLLBACK_BYTES = 1024 * 1024;
+
+export interface Scrollback {
+  append(chunk: string): void;
+  /** The retained output, oldest first. */
+  snapshot(): string;
+  readonly size: number;
+}
+
+export function createScrollback(maxBytes: number = MAX_SCROLLBACK_BYTES): Scrollback {
+  if (!Number.isInteger(maxBytes) || maxBytes <= 0) {
+    throw new RangeError(`maxBytes must be a positive integer, got ${maxBytes}`);
+  }
+  let chunks: Buffer[] = [];
+  let size = 0;
+  return {
+    append(chunk) {
+      const bytes = Buffer.from(chunk, 'utf8');
+      chunks.push(bytes);
+      size += bytes.length;
+      if (size > maxBytes) {
+        // Keep only the newest maxBytes: one copy, then a single retained buffer.
+        const all = Buffer.concat(chunks);
+        const kept = all.subarray(all.length - maxBytes);
+        chunks = [kept];
+        size = kept.length;
+      }
+    },
+    snapshot() {
+      return Buffer.concat(chunks).toString('utf8');
+    },
+    get size() {
+      return size;
+    },
+  };
+}
