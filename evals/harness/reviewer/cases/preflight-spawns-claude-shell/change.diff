@@ -0,0 +1,39 @@
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+
+const execFile = vi.hoisted(() => vi.fn());
+vi.mock('node:child_process', () => ({ execFile }));
+
+const { detectClaude } = await import('./detect.ts');
+
+type Callback = (error: Error | null, stdout: string) => void;
+
+function answer(error: Error | null, stdout: string): void {
+  execFile.mockImplementation((_cmd: string, _args: string[], _opts: object, cb: Callback) => {
+    cb(error, stdout);
+  });
+}
+
+describe('detectClaude', () => {
+  beforeEach(() => execFile.mockReset());
+
+  it('reports the installed version', async () => {
+    answer(null, '2.1.283 (Claude Code)\n');
+    await expect(detectClaude()).resolves.toEqual({ installed: true, version: '2.1.283' });
+  });
+
+  it('reports not installed when the command fails', async () => {
+    answer(new Error('ENOENT'), '');
+    await expect(detectClaude()).resolves.toEqual({ installed: false });
+  });
+
+  it('reports not installed when the output has no version', async () => {
+    answer(null, 'command not found\n');
+    await expect(detectClaude()).resolves.toEqual({ installed: false });
+  });
+
+  it('passes the timeout through', async () => {
+    answer(null, '2.1.283\n');
+    await detectClaude(1234);
+    expect(execFile.mock.calls[0]?.[2]).toMatchObject({ timeout: 1234 });
+  });
+});
