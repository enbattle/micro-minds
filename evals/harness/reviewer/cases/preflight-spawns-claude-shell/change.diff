+import { execFile } from 'node:child_process';
+
+export type ClaudeInstall = { installed: true; version: string } | { installed: false };
+
+const VERSION = /\b(\d+\.\d+\.\d+)\b/;
+
+/**
+ * Preflight: is Claude Code installed, and which version (PLAN §5.6)? Runs `claude --version`
+ * with a short timeout. `shell: true` so Windows finds the npm `claude.cmd` shim as well as
+ * `claude.exe`, the same lookup a user's terminal does; the arguments are fixed, so no user
+ * input ever reaches the shell.
+ */
+export function detectClaude(timeoutMs = 5000): Promise<ClaudeInstall> {
+  return new Promise((resolve) => {
+    execFile(
+      'claude',
+      ['--version'],
+      { shell: true, timeout: timeoutMs, windowsHide: true, encoding: 'utf8' },
+      (error, stdout) => {
+        const version = error ? undefined : VERSION.exec(stdout)?.[1];
+        resolve(version === undefined ? { installed: false } : { installed: true, version });
+      },
+    );
+  });
+}
