+import Fastify from 'fastify';
+import { describe, expect, it, vi } from 'vitest';
+import { FakeSessionRegistry } from '../sessions/fake-session-registry.ts';
+import { HOOK_BODY_LIMIT_BYTES, registerHookRoute } from './ingest-route.ts';
+import { TokenBucketRateLimiter } from './rate-limiter.ts';
+
+const HOST = '127.0.0.1:47800';
+const A = { id: '01J9ZQ4X7M3V6T8K2R5N0PWYBA', hookToken: 'a'.repeat(43) };
+const B = { id: '01J9ZQ4X7M3V6T8K2R5N0PWYBB', hookToken: 'b'.repeat(43) };
+
+function setup() {
+  const ingest = vi.fn<(sessionId: string, payload: unknown) => void>();
+  const app = Fastify();
+  registerHookRoute(app, {
+    sessions: new FakeSessionRegistry([A, B]),
+    rateLimiter: new TokenBucketRateLimiter({ capacity: 100, refillPerSecond: 100 }),
+    allowedHosts: new Set([HOST]),
+    ingest,
+  });
+  return { app, ingest };
+}
+
+function post(headers: Record<string, string>, payload: unknown = { hook_event_name: 'Stop' }) {
+  return { method: 'POST' as const, url: '/hooks', headers: { host: HOST, ...headers }, payload };
+}
+
+describe('POST /hooks', () => {
+  it('accepts a session posting with its own hook token', async () => {
+    const { app, ingest } = setup();
+    const res = await app.inject(
+      post({ 'x-micro-minds-session': A.id, 'x-micro-minds-hook-token': A.hookToken }),
+    );
+    expect(res.statusCode).toBe(204);
+    expect(ingest).toHaveBeenCalledWith(A.id, { hook_event_name: 'Stop' });
+  });
+
+  it.each([
+    { name: "session B's token for session A", session: A.id, token: B.hookToken, extra: {} },
+    { name: 'wrong token', session: A.id, token: 'x'.repeat(43), extra: {} },
+    { name: 'unknown session', session: '01J9ZQ4X7M3V6T8K2R5N0PWYBZ', token: A.hookToken, extra: {} },
+    { name: 'browser origin', session: A.id, token: A.hookToken, extra: { origin: 'http://evil.test' } },
+    { name: 'rebinding host', session: A.id, token: A.hookToken, extra: { host: 'evil.test:47800' } },
+  ])('rejects $name with a bare 404', async ({ session, token, extra }) => {
+    const { app, ingest } = setup();
+    const res = await app.inject(
+      post({ 'x-micro-minds-session': session, 'x-micro-minds-hook-token': token, ...extra }),
+    );
+    expect(res.statusCode).toBe(404);
+    expect(res.body).toBe('');
+    expect(ingest).not.toHaveBeenCalled();
+  });
+
+  it('rejects bodies over the limit', async () => {
+    const { app, ingest } = setup();
+    const res = await app.inject(
+      post(
+        { 'x-micro-minds-session': A.id, 'x-micro-minds-hook-token': A.hookToken },
+        { blob: 'x'.repeat(HOOK_BODY_LIMIT_BYTES) },
+      ),
+    );
+    expect(res.statusCode).toBe(413);
+    expect(ingest).not.toHaveBeenCalled();
+  });
+});
