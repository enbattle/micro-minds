+import { timingSafeEqual } from 'node:crypto';
+import type { FastifyInstance } from 'fastify';
+import { z } from 'zod';
+import type { SessionRegistry } from '../sessions/session-registry.ts';
+import type { RateLimiter } from './rate-limiter.ts';
+
+export const HOOK_BODY_LIMIT_BYTES = 256 * 1024;
+
+const HookHeaders = z.object({
+  host: z.string(),
+  'x-micro-minds-session': z.string().min(1).max(64),
+  'x-micro-minds-hook-token': z.string().min(1).max(256),
+});
+
+export interface HookRouteDeps {
+  sessions: SessionRegistry;
+  rateLimiter: RateLimiter;
+  /** Exact `127.0.0.1:<port>` values this server answers to (DNS-rebinding guard). */
+  allowedHosts: ReadonlySet<string>;
+  /** Normalizes, scrubs, caps and stores the payload; it receives `unknown`, never a cast. */
+  ingest: (sessionId: string, payload: unknown) => void;
+}
+
+function tokenEquals(a: string, b: string): boolean {
+  const left = Buffer.from(a, 'utf8');
+  const right = Buffer.from(b, 'utf8');
+  return left.length === right.length && timingSafeEqual(left, right);
+}
+
+/**
+ * `POST /hooks` (PLAN §9.2, §9.6). Only a session's own hook token can post events for that
+ * session. Every rejection is a bare 404 so callers learn nothing about which sessions exist.
+ */
+export function registerHookRoute(app: FastifyInstance, deps: HookRouteDeps): void {
+  app.post('/hooks', { bodyLimit: HOOK_BODY_LIMIT_BYTES }, async (request, reply) => {
+    // Hooks come from the CLI, never from a browser, so any Origin header is refused.
+    if (request.headers.origin !== undefined) return reply.code(404).send();
+    const headers = HookHeaders.safeParse(request.headers);
+    if (!headers.success || !deps.allowedHosts.has(headers.data.host)) {
+      return reply.code(404).send();
+    }
+    const sessionId = headers.data['x-micro-minds-session'];
+    const session = deps.sessions.get(sessionId);
+    if (
+      session === undefined ||
+      !tokenEquals(headers.data['x-micro-minds-hook-token'], session.hookToken)
+    ) {
+      return reply.code(404).send();
+    }
+    if (!deps.rateLimiter.tryAcquire(sessionId)) return reply.code(429).send();
+    deps.ingest(sessionId, request.body);
+    return reply.code(204).send();
+  });
+}
