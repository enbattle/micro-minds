@@ -0,0 +1,21 @@
+/** Which agent a Claude hook payload belongs to (docs/protocols/claude.md, "Attribution"). */
+export interface Attribution {
+  agentId: string;
+  parentAgentId?: string;
+}
+
+/**
+ * A payload with a non-empty `agent_id` belongs to that subagent, whose parent is the root agent;
+ * anything else to the root agent itself (our session id).
+ *
+ * Fix: this used to test `agent_type`, so the `SubagentStop`s that arrive from agents that never
+ * started (`agent_type: ""`, docs/protocols/claude.md finding 6) were attributed to the root agent
+ * and ended its turn. `agent_id` is what identifies the agent.
+ */
+export function attribute(payload: Record<string, unknown>, sessionId: string): Attribution {
+  const agentId = payload.agent_id;
+  if (typeof agentId === 'string' && agentId !== '') {
+    return { agentId, parentAgentId: sessionId };
+  }
+  return { agentId: sessionId };
+}
