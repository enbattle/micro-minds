+import type { ToolCategory } from '@micro-minds/shared';
+
+/**
+ * Categories for tools every coding CLI ships under the same names. Adapters only list their own
+ * extras; anything they leave out falls back to this table, so a new adapter gets sensible
+ * categories on day one instead of showing every tool as 'other'.
+ */
+const COMMON_TOOLS: Readonly<Record<string, ToolCategory>> = {
+  Read: 'read',
+  Grep: 'read',
+  Glob: 'read',
+  Edit: 'write',
+  Write: 'write',
+  Bash: 'exec',
+  Task: 'delegate',
+  Agent: 'delegate',
+  AskUserQuestion: 'ask',
+  WebFetch: 'web',
+  WebSearch: 'web',
+};
+
+/**
+ * The category of `toolName`: the adapter's own map first, then the common table, then 'other'.
+ * Own-property lookups only, so a tool named `constructor` or `__proto__` is just unmapped.
+ */
+export function categorize(
+  own: Readonly<Record<string, ToolCategory>>,
+  toolName: string,
+): ToolCategory {
+  if (Object.hasOwn(own, toolName)) return own[toolName] ?? 'other';
+  if (Object.hasOwn(COMMON_TOOLS, toolName)) return COMMON_TOOLS[toolName] ?? 'other';
+  return 'other';
+}
