+import { describe, expect, it } from 'vitest';
+import { categorize } from './categories.ts';
+
+describe('categorize', () => {
+  it("uses the adapter's own map first", () => {
+    expect(categorize({ Bash: 'other', run_shell: 'exec' }, 'Bash')).toBe('other');
+    expect(categorize({ run_shell: 'exec' }, 'run_shell')).toBe('exec');
+  });
+
+  it.each([
+    ['Read', 'read'],
+    ['Edit', 'write'],
+    ['Bash', 'exec'],
+    ['Task', 'delegate'],
+    ['AskUserQuestion', 'ask'],
+    ['WebFetch', 'web'],
+  ] as const)('falls back to the common table: %s → %s', (name, category) => {
+    expect(categorize({}, name)).toBe(category);
+  });
+
+  it.each(['mcp__github__create_issue', 'constructor', '__proto__', 'bash', ''])(
+    'an unmapped tool is other: %j',
+    (name) => {
+      expect(categorize({}, name)).toBe('other');
+    },
+  );
+});
