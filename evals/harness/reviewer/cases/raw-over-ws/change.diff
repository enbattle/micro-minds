--- /dev/null
+++ b/apps/server/src/ws/broadcast.ts
@@ -0,0 +1,32 @@
+import type { AgentEvent } from '@micro-minds/shared';
+import type { WebSocket } from 'ws';
+
+export type ServerFrame =
+  | { t: 'event'; event: AgentEvent }
+  | { t: 'pty.exit'; sessionId: string; code: number };
+
+/** Fans server frames out to every authenticated WS client. */
+export class Broadcaster {
+  readonly #clients = new Set<WebSocket>();
+
+  add(socket: WebSocket): void {
+    this.#clients.add(socket);
+    socket.once('close', () => this.#clients.delete(socket));
+  }
+
+  /** Pushes a stored event to every client, which feeds it through the shared reduce(). */
+  publishEvent(event: AgentEvent): void {
+    this.#send({ t: 'event', event });
+  }
+
+  publishExit(sessionId: string, code: number): void {
+    this.#send({ t: 'pty.exit', sessionId, code });
+  }
+
+  #send(frame: ServerFrame): void {
+    const data = JSON.stringify(frame);
+    for (const socket of this.#clients) {
+      if (socket.readyState === socket.OPEN) socket.send(data);
+    }
+  }
+}
