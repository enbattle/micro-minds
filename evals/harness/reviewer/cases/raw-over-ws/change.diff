+import type { AgentEvent } from '@micro-minds/shared';
+import type { ProviderAdapter } from '../providers/adapter.ts';
+import { capRaw, scrubRaw } from '../scrub/scrub.ts';
+import type { EventStore } from '../store/event-store.ts';
+import type { Broadcaster } from '../ws/broadcast.ts';
+import type { EventStamp } from './stamp.ts';
+
+export interface PipelineDeps {
+  adapter: ProviderAdapter;
+  store: EventStore;
+  broadcaster: Broadcaster;
+  stamp: EventStamp;
+}
+
+/** Hook payload → normalized event → event store → every WS client. */
+export function ingestHookPayload(deps: PipelineDeps, sessionId: string, payload: unknown): void {
+  const facts = deps.adapter.normalize(payload);
+  const event: AgentEvent = {
+    ...facts,
+    ...deps.stamp.next(sessionId),
+    provider: deps.adapter.provider,
+    raw: capRaw(scrubRaw(payload), { keepFull: facts.kind === 'unknown' }),
+  };
+  deps.store.append(event);
+  deps.broadcaster.publishEvent(event);
+}
diff --git a/apps/server/src/ws/broadcast.ts b/apps/server/src/ws/broadcast.ts
