+// A stable fingerprint of an event's facts, so a client that receives the same event twice (a WS
+// reconnect replays the tail) can drop the duplicate before reduce() sees it. SHA-256 is a pure
+// function of its input, so this adds no side effect to the package.
+import { createHash } from 'node:crypto';
+import type { AgentEvent } from './events.ts';
+
+/** The fields that make two events the same fact; `id` and `raw` are left out on purpose. */
+function facts(event: AgentEvent): unknown[] {
+  return [
+    event.sessionId,
+    event.agentId,
+    event.kind,
+    event.ts,
+    event.tool?.useId ?? null,
+    event.tool?.name ?? null,
+  ];
+}
+
+export function eventFingerprint(event: AgentEvent): string {
+  return createHash('sha256').update(JSON.stringify(facts(event))).digest('hex');
+}
+
+/** Keeps the first of each fingerprint, in order. */
+export function dedupeEvents(events: readonly AgentEvent[]): AgentEvent[] {
+  const seen = new Set<string>();
+  const kept: AgentEvent[] = [];
+  for (const event of events) {
+    const key = eventFingerprint(event);
+    if (seen.has(key)) continue;
+    seen.add(key);
+    kept.push(event);
+  }
+  return kept;
+}
