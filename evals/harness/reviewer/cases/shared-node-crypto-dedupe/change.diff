+import { describe, expect, it } from 'vitest';
+import type { AgentEvent } from './events.ts';
+import { dedupeEvents, eventFingerprint } from './fingerprint.ts';
+
+const base: AgentEvent = {
+  v: 1,
+  id: '01K6D00000000000000000000A',
+  ts: 1_790_000_000_000,
+  sessionId: '01K6A2B3C4D5E6F7G8H9J0K1M2',
+  provider: 'claude',
+  agentId: '01K6A2B3C4D5E6F7G8H9J0K1M2',
+  kind: 'tool.started',
+  tool: { name: 'Bash', category: 'exec', useId: 'toolu_01' },
+};
+
+describe('eventFingerprint', () => {
+  it('is the same for the same facts under a different id or raw', () => {
+    const again = { ...base, id: '01K6D00000000000000000000B', raw: { x: 1 } };
+    expect(eventFingerprint(again)).toBe(eventFingerprint(base));
+  });
+
+  it('differs when a fact differs', () => {
+    expect(eventFingerprint({ ...base, ts: base.ts + 1 })).not.toBe(eventFingerprint(base));
+    expect(eventFingerprint({ ...base, kind: 'tool.finished' })).not.toBe(eventFingerprint(base));
+  });
+});
+
+describe('dedupeEvents', () => {
+  it('keeps the first of each fact, in order', () => {
+    const second = { ...base, ts: base.ts + 5, kind: 'tool.finished' as const };
+    const replayed = { ...base, id: '01K6D00000000000000000000C' };
+    expect(dedupeEvents([base, second, replayed])).toEqual([base, second]);
+  });
+
+  it('keeps events whose tool is absent', () => {
+    const { tool: _tool, ...noTool } = base;
+    expect(dedupeEvents([noTool, noTool])).toEqual([noTool]);
+  });
+});
